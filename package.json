{
  "name": "pushover-mcp",
  "version": "2.0.0",
  "description": "MCP server for sending Pushover notifications from AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pushover",
    "notifications",
    "ai-agent"
  ],
  "author": "Ashik Nesin <mail@ashiknesin.com>",
  "license": "MIT",
  "homepage": "https://github.com/AshikNesin/pushover-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshikNesin/pushover-mcp.git"
  },
  "bugs": "https://github.com/AshikNesin/pushover-mcp/issues",
  "mcpName": "io.github.AshikNesin/pushover-mcp",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pushover-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "inspect": "pnpm build && npx -y @modelcontextprotocol/inspector node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
